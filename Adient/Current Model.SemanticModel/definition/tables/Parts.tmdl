	partition Parts-c69e773b-3d8c-4c2b-8128-ad8416eb28d7 = m
		mode: import
		queryGroup: Source
		source =
				let
				    #"Parts" = Sql.Database(Server, Database, [Query="DECLARE @sqlQuery NVARCHAR(MAX);#(lf)#(lf)IF COL_LENGTH('report.parts', 'RZAFNames') IS NOT NULL#(lf)#(lf)--suppression jointure report.BufferProfiles pour recuperation champs  RedSafetyZone,RedZoneBase,GreenZoneBase demandee par Hutchinson cim le 16-01-25 mais non utilisee#(lf)#(lf)BEGIN#(lf)#(lf)SET @sqlQuery = '#(lf)    SELECT DB_NAME() as Database_Name,p.Id,p.DataSetId, p.PartNumber,p.PartType, p.Revision,p.LocationId, p.Location,p.OrderCycle,p.OrderMaximumQty, p.OrderMultipleQty, p.OrderMinimumQty, p.MaterialAvailabilityShortage,p.VendorIdentifier,p.Description,p.InventoryMethod, p.InventoryPlanning,p.DailyUsageType, p.DisableAutoProfile, p.RawMaterialsCost,p.PlannerCode, p.MaterialType, p.Notes, p.Vendor,p.TopOfGreen,p.TopOfYellow,p.TopOfRed,p.OnHandQty,p.ForecastedDailyUsage, p.NetFlowPercentage,p.NetFlowQty,p.DemandAllocationQty,p.OnHandQtyMinusDemandAllocationQty,p.AlertType,p.FixedLeadTime,p.GoodsReceiptTime, p.SupplyOrderFollowUpBy,p.AlertDate,SupplyOrderNote,p.AlertSeverity,p.EffectiveDailyUsage,p.ReorderQuantityTo, p.BoMType,p.Priority,p.InventoryQty,p.DecoupledLeadTime,p.TargetedInventory,p.AverageDailyUsage, p.RPlusLeadTime, p.RequestDate, p.DueDate,p.EffectiveLeadTime,p.SupplyOrderQty,p.RZAFValue,p.YZAFValue,p.TodaysYZAF,p.CDAFTargetedInventory, p.CDAFTargetedInventoryType, p.TodaysRZAF,p.ShelfLife, p.UserDefined1,p.ReorderQuantityFrom,p.UserDefined2,p.UserDefined3,p.UserDefined4,p.UserDefined5,p.UserDefined6,p.UserDefined7,p.UserDefined8,p.UserDefined9,p.UserDefined10,p.UserDefined11,p.UserDefined12,p.UserDefined13,p.UserDefined14,p.UserDefined15,p.UserDefined16,p.YZAFNames as YZAFName,p.RZAFNames as RZAFName ,p.YZAFTypeDescriptions as YZAFType,p.RZAFTypeDescriptions as RZAFType,case when p.NetFlowQty> p.TopOfGreen and p.TopOfGreen > 0 then ''Blue'' else  null end as ""Blue"", case when p.NetFlowQty > p.TopOfYellow and p.NetFlowQty <=p.TopOfGreen then ''Green'' else  null end  as ""Green"",case when p.NetFlowQty > p.TopOfRed and p.NetFlowQty <= p.TopOfYellow then ''Yellow'' else  null end ""Yellow"", case when p.NetFlowQty<=p.TopOfRed and p.TopOfGreen> 0 then ''Red'' else null end ""Red"" FROM report.Parts p With (NOLOCK)   ' ;#(lf)END#(lf)#(lf)ELSE#(lf)BEGIN#(lf)SET @sqlQuery = '#(lf)    SELECT DB_NAME() as Database_Name,p.Id,p.DataSetId, p.PartNumber,p.PartType, p.Revision,p.LocationId, p.Location,p.OrderCycle,p.OrderMaximumQty, p.OrderMultipleQty, p.OrderMinimumQty, p.MaterialAvailabilityShortage,p.VendorIdentifier,p.Description,p.InventoryMethod, p.InventoryPlanning,p.DailyUsageType, p.DisableAutoProfile, p.RawMaterialsCost,p.PlannerCode, p.MaterialType, p.Notes, p.Vendor,p.TopOfGreen,p.TopOfYellow,p.TopOfRed,p.OnHandQty,p.ForecastedDailyUsage, p.NetFlowPercentage,p.NetFlowQty,p.DemandAllocationQty,p.OnHandQtyMinusDemandAllocationQty,p.AlertType,p.FixedLeadTime,p.GoodsReceiptTime, p.SupplyOrderFollowUpBy,p.AlertDate,SupplyOrderNote,p.AlertSeverity,p.EffectiveDailyUsage,p.ReorderQuantityTo, p.BoMType,p.Priority,p.InventoryQty,p.DecoupledLeadTime,p.TargetedInventory,p.AverageDailyUsage, p.RPlusLeadTime, p.RequestDate, p.DueDate,p.EffectiveLeadTime,p.SupplyOrderQty,p.RZAFName,p.RZAFValue,p.YZAFName,p.YZAFValue,p.TodaysYZAF,p.CDAFTargetedInventory, p.CDAFTargetedInventoryType, p.TodaysRZAF,p.RZAFType,p.YZAFType,p.ShelfLife, p.UserDefined1,p.ReorderQuantityFrom,p.UserDefined2,p.UserDefined3,p.UserDefined4,p.UserDefined5,p.UserDefined6,p.UserDefined7,p.UserDefined8,p.UserDefined9,p.UserDefined10,p.UserDefined11,p.UserDefined12,p.UserDefined13,p.UserDefined14,p.UserDefined15,p.UserDefined16,case when p.NetFlowQty> p.TopOfGreen and p.TopOfGreen > 0 then ''Blue'' else  null end as ""Blue"", case when p.NetFlowQty > p.TopOfYellow and p.NetFlowQty <=p.TopOfGreen then ''Green'' else  null end  as ""Green"",case when p.NetFlowQty > p.TopOfRed and p.NetFlowQty <= p.TopOfYellow then ''Yellow'' else  null end ""Yellow"", case when p.NetFlowQty<=p.TopOfRed and p.TopOfGreen> 0 then ''Red'' else null end ""Red""  FROM report.Parts p With (NOLOCK)';#(lf)END#(lf)EXEC sp_executesql @sqlQuery;"]),
