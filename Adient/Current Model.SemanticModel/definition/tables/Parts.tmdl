	column 'Delta ADU FDU' =
			
			IF(([AverageDailyUsage]+'Parts'[ForecastedDailyUsage])<>0,
			DIVIDE(([ForecastedDailyUsage]-[AverageDailyUsage]), ([AverageDailyUsage]+'Parts'[ForecastedDailyUsage]))
			,BLANK())
		formatString: 0\ %;-0\ %;0\ %
