	partition PartTransitions_followup = m
		mode: import
		queryGroup: Source
		source = ```
				let
				    report_Parts = Sql.Database(Server, Database, [Query="select [$Outer].[SourcePartId] as [SourcePartId],
				    [$Outer].[SourcePartNumber] as [SourcePartNumber],
				    [$Outer].[SourcePartLocation] as [SourcePartLocation],
				    [$Outer].[TargetPartId] as [TargetPartId],
				    [$Outer].[TargetPartNumber] as [TargetPartNumber],
				    [$Outer].[TargetPartLocation] as [TargetPartLocation],
				    [$Outer].[StartDate] as [StartDate],
				    [$Outer].[EndDate] as [EndDate],
				    [$Outer].[ADULinkMethod] as [ADULinkMethod],
				    [$Outer].[ConversionRatio] as [ConversionRatio],
				    [$Outer].[NetFlowLink] as [NetFlowLink],
				    [$Outer].[InventoryPlanning] as [Target.InventoryPlanning],
				    [$Outer].[EffectiveDailyUsage] as [Target.EffectiveDailyUsage],
				    [$Inner].[InventoryPlanning2] as [Source.InventoryPlanning],
				    [$Inner].[EffectiveDailyUsage2] as [Source.EffectiveDailyUsage],
				    [$Inner].[InventoryQty] as [Source.InventoryQty]
				from 
				(
				    select [$Outer].[SourcePartId],
				        [$Outer].[SourcePartNumber],
				        [$Outer].[SourcePartLocation],
				        [$Outer].[TargetPartId],
				        [$Outer].[TargetPartNumber],
				        [$Outer].[TargetPartLocation],
				        [$Outer].[StartDate],
				        [$Outer].[EndDate],
				        [$Outer].[ADULinkMethod],
				        [$Outer].[ConversionRatio],
				        [$Outer].[NetFlowLink],
				        [$Inner].[InventoryPlanning],
				        [$Inner].[EffectiveDailyUsage]
				    from 
				    (
				        select [SourcePartId],
				            [SourcePartNumber],
				            [SourcePartLocation],
				            [TargetPartId],
				            [TargetPartNumber],
				            [TargetPartLocation],
				            [StartDate],
				            [EndDate],
				            [ADULinkMethod],
				            [ConversionRatio],
				            [NetFlowLink]
				        from [report].[PartTransitions] as [$Table]
				    ) as [$Outer]
				    left outer join [report].[Parts] as [$Inner] on ([$Outer].[TargetPartId] = [$Inner].[Id])
				) as [$Outer]
				left outer join 
				(
				    select [_].[DataSetId] as [DataSetId],
				        [_].[Id] as [Id],
				        [_].[LocationId] as [LocationId],
				        [_].[PartNumber] as [PartNumber],
				        [_].[Revision] as [Revision],
				        [_].[Location] as [Location],
				        [_].[Description] as [Description],
				        [_].[InventoryMethod] as [InventoryMethod],
				        [_].[InventoryPlanning] as [InventoryPlanning2],
				        [_].[BufferProfileId] as [BufferProfileId],
				        [_].[PlanningCalendarId] as [PlanningCalendarId],
				        [_].[PlannedAdjustmentFactorId] as [PlannedAdjustmentFactorId],
				        [_].[UnitOfMeasure] as [UnitOfMeasure],
				        [_].[PartType] as [PartType],
				        [_].[DailyUsageType] as [DailyUsageType],
				        [_].[FixedLeadTime] as [FixedLeadTime],
				        [_].[GoodsReceiptTime] as [GoodsReceiptTime],
				        [_].[AutoApproveRecommendedOrders] as [AutoApproveRecommendedOrders],
				        [_].[DisableAutoProfile] as [DisableAutoProfile],
				        [_].[AlertHorizon] as [AlertHorizon],
				        [_].[DecoupledLeadTime] as [DecoupledLeadTime],
				        [_].[OrderCycle] as [OrderCycle],
				        [_].[OrderMaximumQty] as [OrderMaximumQty],
				        [_].[OrderMinimumQty] as [OrderMinimumQty],
				        [_].[OrderMultipleQty] as [OrderMultipleQty],
				        [_].[ManualTopOfRed] as [ManualTopOfRed],
				        [_].[ManualTopOfYellow] as [ManualTopOfYellow],
				        [_].[ManualTopOfGreen] as [ManualTopOfGreen],
				        [_].[OutSourceCost] as [OutSourceCost],
				        [_].[RawMaterialsCost] as [RawMaterialsCost],
				        [_].[PlannerCode] as [PlannerCode],
				        [_].[MaterialType] as [MaterialType],
				        [_].[Notes] as [Notes],
				        [_].[Vendor] as [Vendor],
				        [_].[VendorIdentifier] as [VendorIdentifier],
				        [_].[IncludeInMAC] as [IncludeInMAC],
				        [_].[FixedReorderCycle] as [FixedReorderCycle],
				        [_].[SourceErp] as [SourceErp],
				        [_].[TopOfGreen] as [TopOfGreen],
				        [_].[TopOfYellow] as [TopOfYellow],
				        [_].[TopOfRed] as [TopOfRed],
				        [_].[TodaysPAF] as [TodaysPAF],
				        [_].[ReorderPoint] as [ReorderPoint],
				        [_].[RedZoneBase] as [RedZoneBase],
				        [_].[PercentageOfToR] as [PercentageOfToR],
				        [_].[PercentageOfToRSpike] as [PercentageOfToRSpike],
				        [_].[OrderSpikeHorizon] as [OrderSpikeHorizon],
				        [_].[SupplyOrderQty] as [SupplyOrderQty],
				        [_].[OnHandQty] as [OnHandQty],
				        [_].[DemandAllocationQty] as [DemandAllocationQty],
				        [_].[IssuedQty] as [IssuedQty],
				        [_].[ForecastedDailyUsage] as [ForecastedDailyUsage],
				        [_].[EffectiveDailyUsage] as [EffectiveDailyUsage2],
				        [_].[AverageDailyUsage] as [AverageDailyUsage],
				        [_].[RPlusLeadTime] as [RPlusLeadTime],
				        [_].[Priority] as [Priority],
				        [_].[BufferAlertLevel] as [BufferAlertLevel],
				        [_].[ReminderStatus] as [ReminderStatus],
				        [_].[IsOrderSpike] as [IsOrderSpike],
				        [_].[LTMTotalOrders] as [LTMTotalOrders],
				        [_].[AlertSeverity] as [AlertSeverity],
				        [_].[DueDate] as [DueDate],
				        [_].[ReorderQuantityTo] as [ReorderQuantityTo],
				        [_].[InventoryQty] as [InventoryQty],
				        [_].[NetFlowQty] as [NetFlowQty],
				        [_].[NetFlowPercentage] as [NetFlowPercentage],
				        [_].[TargetedInventory] as [TargetedInventory],
				        [_].[TodaysYZAF] as [TodaysYZAF],
				        [_].[YZAFType] as [YZAFType],
				        [_].[YZAFValue] as [YZAFValue],
				        [_].[YZAFName] as [YZAFName],
				        [_].[CDAFTargetedInventory] as [CDAFTargetedInventory],
				        [_].[CDAFTargetedInventoryType] as [CDAFTargetedInventoryType],
				        [_].[TodaysRZAF] as [TodaysRZAF],
				        [_].[RZAFValue] as [RZAFValue],
				        [_].[RZAFType] as [RZAFType],
				        [_].[RZAFName] as [RZAFName],
				        [_].[EffectiveLeadTime] as [EffectiveLeadTime],
				        [_].[ReorderQuantityFrom] as [ReorderQuantityFrom],
				        [_].[ScheduleOrderDate] as [ScheduleOrderDate],
				        [_].[RequestDate] as [RequestDate],
				        [_].[OrderReceiptDate] as [OrderReceiptDate],
				        [_].[SupplyOrderFollowUpBy] as [SupplyOrderFollowUpBy],
				        [_].[SupplyOrderNote] as [SupplyOrderNote],
				        [_].[MaterialAvailabilityShortage] as [MaterialAvailabilityShortage],
				        [_].[MaterialAvailabilityShortageAsChild] as [MaterialAvailabilityShortageAsChild],
				        [_].[CustomOrderDueDate] as [CustomOrderDueDate],
				        [_].[DaysUntilYellow] as [DaysUntilYellow],
				        [_].[OrderIntervalDays] as [OrderIntervalDays],
				        [_].[AlertType] as [AlertType],
				        [_].[AlertJSONBlob] as [AlertJSONBlob],
				        [_].[DeploymentQuantity] as [DeploymentQuantity],
				        [_].[ShortfallQuantity] as [ShortfallQuantity],
				        [_].[StandardDeviationOfDemand] as [StandardDeviationOfDemand],
				        [_].[UserDefined1] as [UserDefined1],
				        [_].[UserDefined2] as [UserDefined2],
				        [_].[UserDefined3] as [UserDefined3],
				        [_].[UserDefined4] as [UserDefined4],
				        [_].[UserDefined5] as [UserDefined5],
				        [_].[UserDefined6] as [UserDefined6],
				        [_].[UserDefined7] as [UserDefined7],
				        [_].[UserDefined8] as [UserDefined8],
				        [_].[UserDefined9] as [UserDefined9],
				        [_].[UserDefined10] as [UserDefined10],
				        [_].[UserDefined11] as [UserDefined11],
				        [_].[UserDefined12] as [UserDefined12],
				        [_].[UserDefined13] as [UserDefined13],
				        [_].[UserDefined14] as [UserDefined14],
				        [_].[UserDefined15] as [UserDefined15],
				        [_].[UserDefined16] as [UserDefined16],
				        [_].[ShelfLife] as [ShelfLife],
				        [_].[BoMType] as [BoMType],
				        [_].[SourceInformation1] as [SourceInformation1],
				        [_].[SourceInformation2] as [SourceInformation2],
				        [_].[SourceInformation3] as [SourceInformation3],
				        [_].[AlertDate] as [AlertDate],
				        [_].[NetFlowQtyMinusTopOfGreen] as [NetFlowQtyMinusTopOfGreen],
				        [_].[OnHandQtyMinusDemandAllocationQty] as [OnHandQtyMinusDemandAllocationQty],
				        [_].[SourceLocation] as [SourceLocation],
				        [_].[ForecastedDailyUsageHorizonOverride] as [ForecastedDailyUsageHorizonOverride],
				        [_].[AverageDailyUsageHorizonOverride] as [AverageDailyUsageHorizonOverride]
				    from [report].[Parts] as [_]
				) as [$Inner] on ([$Outer].[SourcePartId] = [$Inner].[Id])"])
				in
				    report_Parts
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

