table Calendar_BestByDate
	lineageTag: 830d7a20-3711-4a67-892e-454d7b686727

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 6cb2df7d-d177-40ff-b2e4-9f7e602e4dee
		summarizeBy: none
		sourceColumn: Date

		variation Variation
			isDefault
			relationship: dcff3f40-5dd1-49de-a673-609a08dc9ae3
			defaultHierarchy: LocalDateTable_82fcd428-81af-4f9d-b32d-8ad22743217e.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Calendar_BestByDate = m
		mode: import
		queryGroup: Source
		source =
				let
				    DateDebut = DateTime.Date(DateTime.LocalNow()),
				    DateFin = Date.AddDays(DateTime.Date(DateTime.LocalNow()),720),
				    NbJours = Duration.Days(DateFin - DateDebut),
				    ListeDates = List.Dates(DateDebut, NbJours+1, #duration(1,0,0,0)),
				    TableDates = Table.FromColumns({ListeDates}, {"Date"}),
				    #"Type modifié" = Table.TransformColumnTypes(TableDates,{{"Date", type date}})
				in
				    #"Type modifié"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

