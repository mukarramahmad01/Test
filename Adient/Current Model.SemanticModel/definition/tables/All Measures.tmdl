			    DIVIDE (
			        SUMX (
			            Parts,
			            ( 'Parts'[TopOfGreen] - 'Parts'[TopOfYellow] ) * Parts[RawMaterialsCost]
			        ),
			        [EDU Value]
			    ),
			    CALCULATE (
			        SUMX (
			            Parts,
			            DIVIDE (
			                'Parts'[TopOfGreen] - 'Parts'[TopOfYellow],
			                CALCULATE ( SELECTEDVALUE ( 'Unit'[Quantity] ), RELATEDTABLE ( 'Unit' ) )
			            )
			        )
			    )
			)
			
