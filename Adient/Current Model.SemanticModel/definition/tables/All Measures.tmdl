	measure RedZone = IF(SELECTEDVALUE('Unit'[Unit])="Stock Days",DIVIDE(SUMx(parts,Parts[TopOfRed]*Parts[RawMaterialsCost]),[EDU Value]) , CALCULATE(SUMX(Parts,DIVIDE('Parts'[TopOfRed],CALCULATE(SELECTEDVALUE('Unit'[Quantity]),RELATEDTABLE('Unit'))))) )
