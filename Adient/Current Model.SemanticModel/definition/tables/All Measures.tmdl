	measure 'BestByDate Qty' =
			
			
			VAR SKU = SELECTEDVALUE(PartInventories[PartId])
			RETURN
			CALCULATE(
			    SUM(PartInventories[OnHandInventory]),
			    FILTER(
			        ALL(PartInventories),
			        PartInventories[ExpirationDate] > [BestDate] &&
			        PartInventories[ExpirationDate] <= SELECTEDVALUE(PartInventories[ExpirationDate]) &&
			        PartInventories[PartId] = SKU
