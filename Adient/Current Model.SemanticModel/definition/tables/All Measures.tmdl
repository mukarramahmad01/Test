	measure YellowZone = ```
			
			IF (
			    SELECTEDVALUE ( 'Unit'[Unit] ) = "Stock Days",
			    DIVIDE (
			        SUMX (
			            Parts,
			            ( 'Parts'[TopOfYellow] - 'Parts'[TopOfRed] ) * Parts[RawMaterialsCost]
			        ),
			        [EDU Value]
			    ),
			    CALCULATE (
			        SUMX (
			            Parts,
			            DIVIDE (
			                'Parts'[TopOfYellow] - 'Parts'[TopOfRed],
			                CALCULATE ( SELECTEDVALUE ( 'Unit'[Quantity] ), RELATEDTABLE ( 'Unit' ) )
			            )
			        )
			    )
			)
			
			```
		displayFolder: Current Model
		lineageTag: 121c9932-b52d-46ef-b836-02ff24a78f85

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure GreenZone = ```
			
			IF (
