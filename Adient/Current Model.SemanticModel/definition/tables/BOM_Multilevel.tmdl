table BOM_Multilevel
	lineageTag: f64e3526-be31-4b3f-8c0f-f94b0601b20e

	measure 'Nb Of Item Children' =
			VAR Measures=DISTINCTCOUNT(BOM_Multilevel[ChildPartId])
			return IF(Measures<>0,Measures,BLANK())
		formatString: #,0
		lineageTag: e9c32073-1430-4a46-9d1e-8cf79dfb66eb

	measure BOMVariant = IF([Nb Of Item Children]<>BLANK(),"1",BLANK())
		lineageTag: 219b6ddb-fd06-424c-8cb7-95da10800b75

