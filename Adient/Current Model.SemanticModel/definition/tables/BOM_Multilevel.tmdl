	partition BOM_Multilevel = m
		mode: import
		queryGroup: BOM
		source =
				let
				    Source = BOM_Source,
				    #"Requêtes fusionnées" = Table.NestedJoin(Source, {"ChildPartId"}, #"Has Child", {"Id"}, "Has Child", JoinKind.Inner),
				    #"Has Child développé" = Table.ExpandTableColumn(#"Requêtes fusionnées", "Has Child", {"Id"}, {"Has Child.Id"}),
				    #"Colonnes supprimées" = Table.RemoveColumns(#"Has Child développé",{"PrevParentId", "Has Child.Id", "Ratio"}),
				    #"Personnalisée ajoutée" = Table.AddColumn(#"Colonnes supprimées", "PrevParentId", each [ChildPartId]),
				    #"Type modifié" = Table.TransformColumnTypes(#"Personnalisée ajoutée",{{"PrevParentId", Int64.Type}}),
				    #"Personnalisée ajoutée1" = Table.AddColumn(#"Type modifié", "Ratio", each 1),
				    #"Type modifié1" = Table.TransformColumnTypes(#"Personnalisée ajoutée1",{{"Ratio", type number}}),
				    Combine=Table.Combine({#"Type modifié1", Source}),
				    #"Removed Duplicates" = Table.Distinct(Combine)
				in
				    #"Removed Duplicates"

