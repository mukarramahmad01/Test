expression 'Where Used Source' = ```
		let
		    Source = Sql.Database(Server,Database,[Query=" WITH BillOfMaterials1 as (
		    SELECT DISTINCT
		        b.ChildPartId,
		        b.ChildPartId AS PrevPartId,
		        b.ParentPartId,
		        b.Quantity
		    FROM Report.BillOfMaterials AS b),
		
		BottomUp AS (
		    -- Anchor member
		    SELECT DISTINCT
		        b.ChildPartId,
		        b.ChildPartId AS PrevPartId,
		        b.ParentPartId,
		        1 AS Level,
		        CAST(b.Quantity AS FLOAT) AS Ratio
		    FROM Report.BillOfMaterials AS b WITH (NOLOCK)
		
		    UNION ALL
		
		    -- Recursive member
		    SELECT
		        c.ChildPartId,
		        b.ChildPartId AS PrevPartId,
		        b.ParentPartId,
		        c.Level + 1 AS Level,
		        c.Ratio * b.Quantity AS Ratio
		    FROM BillOfMaterials1 AS b WITH (NOLOCK)
		    INNER JOIN BottomUp AS c 
		        ON c.ParentPartId = b.ChildPartId
		    WHERE c.Level < 10
		)
		SELECT *   -- deduplicate here if needed
		FROM BottomUp
		OPTION (MAXRECURSION 10);"])
		in
		    Source
		```
	lineageTag: 6303414d-2734-4b77-a012-c1a4d9aeb2e1
	queryGroup: BOM

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Has Parent' =
