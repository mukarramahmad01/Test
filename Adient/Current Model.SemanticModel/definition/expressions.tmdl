expression BOM_Source = ```
		let
		    Source = Sql.Database(#"Server",#"Database",[Query="WITH BillOfMaterials1 as (SELECT distinct b.ChildPartId, b.ParentPartId as PrevParentId,b.ParentPartId, b.Quantity FROM Report.BillOfMaterials AS b With (NOLOCK)),
		
		TopDown AS ( SELECT distinct ChildPartId, ParentPartId as PrevParentId, ParentPartId, 1 AS level, cast(Quantity as float) as Ratio   FROM Report.BillOfMaterials AS b With (NOLOCK) UNION ALL SELECT b.ChildPartId, b.ParentPartId as PrevParentId,c.ParentPartId, level = c.level + 1,Ratio = Ratio * Quantity FROM BillOfMaterials1 AS b With (NOLOCK) INNER JOIN TopDown c ON b.ParentPartId = c.ChildPartId  where level<10) 
		
		
		SELECT *FROM TopDown"])
		in
		    Source
		```
	lineageTag: 81d7716a-01b9-4c4a-83c6-200b721bee05
