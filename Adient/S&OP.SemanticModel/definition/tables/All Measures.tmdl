	measure DrillthroughDateFormatted = ```
			
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(SELECTEDVALUE('Calendar'[Start Of Month])),
			        FORMAT(SELECTEDVALUE('Calendar'[Start Of Month]), "MMM YYYY"),
			    NOT ISBLANK(SELECTEDVALUE('Calendar'[Start Of Quarter])),
			        "Q" & FORMAT(SELECTEDVALUE('Calendar'[Start Of Quarter]), "Q") & " " & FORMAT(SELECTEDVALUE('Calendar'[Start Of Quarter]), "YYYY"),
			    NOT ISBLANK(SELECTEDVALUE('Calendar'[Start Of Week])),
			        FORMAT(SELECTEDVALUE('Calendar'[Start Of Week]), "DD MMM YYYY"),
			    NOT ISBLANK(SELECTEDVALUE('Calendar'[Start Of Year])),
			        FORMAT(SELECTEDVALUE('Calendar'[Start Of Year]), "YYYY"),
			    "No Date Selected"
			)
			
			```
		displayFolder: DrillThrough
		lineageTag: 9c9a4644-5a97-4887-8cfd-1e40fa222b7a

	measure IsConstraint =
			
			VAR _HasConstraint =
			    CALCULATE(
			        COUNTROWS(Resources),
			        REMOVEFILTERS(Resources),
			        FILTER(Resources, Resources[ResourceType] = "Constraint")
			    )
			RETURN
			IF(_HasConstraint > 0, 1, 0)
		formatString: 0
		displayFolder: DrillThrough
		lineageTag: e9c48b5c-a63b-4db2-857b-f198cc1bf2c9

	measure TextDT = ```
			
			VAR _MonthFiltered = ISFILTERED('Calendar'[Start Of Month])
			VAR _QuarterFiltered = ISFILTERED('Calendar'[Start Of Quarter])
			VAR _WeekFiltered = ISFILTERED('Calendar'[Start Of Week])
			VAR _YearFiltered = ISFILTERED('Calendar'[Start Of Year])
			
			RETURN
			SWITCH(
			    TRUE(),
			    NOT (_MonthFiltered || _QuarterFiltered || _WeekFiltered || _YearFiltered), 
			        "Select data for details", "Click for details"
			)
			
			```
		displayFolder: DrillThrough
		lineageTag: 63b5157c-b9e4-4e99-acfe-b5b443552ba4

