	measure 'Simulation Inventory Unconstrained Without History' =
			
			VAR measure_=SELECTEDVALUE('Inv Agregation'[Agregation])
			VAR Inventory= SWITCH(measure_,
			"Period Avg",IF(SELECTEDVALUE(Period[Period Commande])<>4,SUM('SimulationPartForecastsMonthly'[ProjectedInventory_Positive]),SUM('SimulationPartForecastsWeekly'[ProjectedInventory_Positive]))/DISTINCTCOUNT('Calendar'[Date]),
			"End of Period", IF(SELECTEDVALUE(Period[Period Commande])<>4,SUMX(
			    FILTER('SimulationPartForecastsMonthly',and('SimulationPartForecastsMonthly'[EndMonthInventory]>0,SimulationPartForecastsMonthly[Date]=MAX('Calendar'[Date]))),
			    'SimulationPartForecastsMonthly'[EndMonthInventory]
			),SUMX(
			    FILTER('SimulationPartForecastsWeekly','SimulationPartForecastsWeekly'[EndWeekInventory]>0),
			    'SimulationPartForecastsWeekly'[EndWeekInventory]
			)))
			
			RETURN Inventory
		formatString: #,0
		displayFolder: Simulations_Measures
		lineageTag: 1f099056-7494-4522-9e4e-bfe5ded92143

	measure 'Simulation Inventory Constrained Without History' =
			
			VAR measure_=SELECTEDVALUE('Inv Agregation'[Agregation])
			VAR Inventory= SWITCH(measure_,
			"Period Avg",IF(SELECTEDVALUE(Period[Period Commande])<>4,SUM('SimulationPartForecastsMonthly'[ProjectedInventoryConstrainedPositive]),SUM('SimulationPartForecastsWeekly'[ProjectedInventoryConstrainedPositive]))/DISTINCTCOUNT('Calendar'[Date]),
			"End of Period", IF(SELECTEDVALUE(Period[Period Commande])<>4,SUMX(
			    FILTER('SimulationPartForecastsMonthly',and('SimulationPartForecastsMonthly'[EndMonthInventory]>0,SimulationPartForecastsMonthly[Date]=MAX('Calendar'[Date]))),
			    'SimulationPartForecastsMonthly'[EndMonthInventory]
			),SUMX(
			    FILTER('SimulationPartForecastsWeekly','SimulationPartForecastsWeekly'[EndWeekInventory]>0),
			    'SimulationPartForecastsWeekly'[EndWeekInventory]
			)))
			
			RETURN Inventory
		formatString: #,0
		displayFolder: Simulations_Measures
		lineageTag: c4d5c2cf-c268-438b-9bbd-a0c9de057bcf

	measure 'Backorders Inventory Constrained' = ```
			VAR measure_=SELECTEDVALUE('Inv Agregation'[Agregation])
			return SWITCH(measure_,
			"Period Avg",IF(SELECTEDVALUE(Period[Period Commande])<>4,SUM('SimulationPartForecastsMonthly'[ProjectedInventoryConstrainedNegative]),SUM('SimulationPartForecastsWeekly'[ProjectedInventoryConstrainedNegative]))/DISTINCTCOUNT('Calendar'[Date])
			 ,
			"End of Period",IF(SELECTEDVALUE(Period[Period Commande])<>4,SUMX(
			    FILTER('SimulationPartForecastsMonthly',and('SimulationPartForecastsMonthly'[EndMonthInventory]<0,SimulationPartForecastsMonthly[Date]=MAX('Calendar'[Date]))),
			    'SimulationPartForecastsMonthly'[EndMonthInventory]
			),SUMX(
			    FILTER('SimulationPartForecastsWeekly','SimulationPartForecastsWeekly'[EndWeekInventory]<0),
			    'SimulationPartForecastsWeekly'[EndWeekInventory]
			)))
			
			```
		formatString: 0
		displayFolder: Simulations_Measures
		lineageTag: 8bbfd122-4d24-4760-94d7-48c8af4e554e

	measure 'Backorders Inventory Unconstrained' =
			VAR measure_=SELECTEDVALUE('Inv Agregation'[Agregation])
			VAR Backorders= SWITCH(measure_,
			"Period Avg",IF(SELECTEDVALUE(Period[Period Commande])<>4,SUM('SimulationPartForecastsMonthly'[ProjectedInventory_Negative]),SUM('SimulationPartForecastsWeekly'[ProjectedInventory_Negative]))/DISTINCTCOUNT('Calendar'[Date])
			 ,
			"End of Period",IF(SELECTEDVALUE(Period[Period Commande])<>4,SUMX(
			    FILTER('SimulationPartForecastsMonthly',and('SimulationPartForecastsMonthly'[EndMonthInventory]<0,SimulationPartForecastsMonthly[Date]=MAX('Calendar'[Date]))),
			    'SimulationPartForecastsMonthly'[EndMonthInventory]
			),SUMX(
			    FILTER('SimulationPartForecastsWeekly','SimulationPartForecastsWeekly'[EndWeekInventory]<0),
			    'SimulationPartForecastsWeekly'[EndWeekInventory]
			)))
			
			RETURN Backorders
		formatString: 0
		displayFolder: Simulations_Measures
		lineageTag: 6d15503b-6671-4aa5-b80e-dec581f4995d

