	measure DemandWithSellingPrice =
			VAR measure_=SELECTEDVALUE(Unit_SellingPrice[Unit])
			return SWITCH(measure_,
			"RMCost",[SimulationDemandVal],
			"SellingPrice",IF(SELECTEDVALUE(Period[Period Commande])<>4,sumx('SimulationPartForecastsDemandMonthly','SimulationPartForecastsDemandMonthly'[Demand]*DIVIDE(RELATED(AverageSellingPrice[AverageSellingPrice]),RELATED(Parts[RawMaterialsCost]))),sumx('SimulationPartForecastsDemandWeekly','SimulationPartForecastsDemandWeekly'[Demand]*DIVIDE(RELATED(AverageSellingPrice[AverageSellingPrice]),RELATED(Parts[RawMaterialsCost])))))
		displayFolder: Simulations_Measures
		lineageTag: 21e2d3bb-e600-4a26-acb3-5a17e8401733

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dependent Demand' =
			
			VAR SelectedUnit=SELECTEDVALUE('Unit Children'[Unit])
			RETURN
			
			        IF(
			            SelectedUnit = "Stock Days",
			            DIVIDE(
			                SUMX(DemandForecasts, DemandForecasts[Value] * DemandForecasts[RawMaterialCost]),
			                [EDU Child Value]
			            ),
			            CALCULATE(
			                SUMX(
			                    DemandForecasts,
			                    DIVIDE(
			                        DemandForecasts[Value],
			                        CALCULATE(SELECTEDVALUE('Unit Children'[Quantity]), RELATEDTABLE('Unit Children'))
			                    )
			                )
			            )
			        )
		displayFolder: Simulations_Measures
		lineageTag: 81f8296a-48cc-40ce-9f05-8ae1948845b9

	measure Dependent+Independent = [Dependent Demand]+[Independent Demand]
		displayFolder: Simulations_Measures
		lineageTag: 8c371555-d601-4dfa-882d-9a760ca88d0c

	measure 'Independent Demand' =
			VAR SelectedUnit=SELECTEDVALUE('Unit Children'[Unit])
			RETURN
			
			        IF(
			            SelectedUnit = "Stock Days",
			            DIVIDE(
			                SUMX(DemandForecasts, DemandForecasts[OriginalValue] * DemandForecasts[RawMaterialCost]),
			                [EDU Child Value]
			            ),
			            CALCULATE(
			                SUMX(
			                    DemandForecasts,
			                    DIVIDE(
			                        DemandForecasts[OriginalValue],
			                        CALCULATE(SELECTEDVALUE('Unit Children'[Quantity]), RELATEDTABLE('Unit Children'))
			                    )
			                )
			            )
			        )
		displayFolder: Simulations_Measures
		lineageTag: b94892d3-c2ac-4cd7-8390-201487ab7a12

