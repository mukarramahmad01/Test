	measure 'Dependent Demand' =
			
			VAR SelectedUnit=SELECTEDVALUE('Unit Children'[Unit])
			RETURN
			
			        IF(
			            SelectedUnit = "Stock Days",
			            DIVIDE(
			                SUMX(DemandForecasts, DemandForecasts[Value] * DemandForecasts[RawMaterialCost]),
			                [EDU Child Value]
			            ),
			            CALCULATE(
			                SUMX(
			                    DemandForecasts,
			                    DIVIDE(
			                        DemandForecasts[Value],
			                        CALCULATE(SELECTEDVALUE('Unit Children'[Quantity]), RELATEDTABLE('Unit Children'))
			                    )
			                )
			            )
			        )
		displayFolder: Simulations_Measures
		lineageTag: 81f8296a-48cc-40ce-9f05-8ae1948845b9

	measure Dependent+Independent = [Dependent Demand]+[Independent Demand]
