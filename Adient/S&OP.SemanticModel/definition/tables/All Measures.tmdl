	measure SimulationYellowCDAFVal =
			IF(SELECTEDVALUE(Period[Period Commande])<>4,CALCULATE (
			    SUMX (
			        FILTER('SimulationPartForecasts_BufferItemsMonthly','SimulationPartForecasts_BufferItemsMonthly'[Projected EDU]<>BLANK()),
			        ('SimulationPartForecasts_BufferItemsMonthly'[Top Of Yellow]
			            - 'SimulationPartForecasts_BufferItemsMonthly'[Top Of Red])-SimulationPartForecasts_BufferItemsMonthly[Projected EDU]*RELATED(Parts[RPlusLeadTime])
			    ),
			    Parts[InventoryMethod] = 1
			),CALCULATE (
			    SUMX (
			        FILTER('SimulationPartForecasts_BufferItemsWeekly','SimulationPartForecasts_BufferItemsWeekly'[Projected EDU]<>BLANK()),
			        ('SimulationPartForecasts_BufferItemsWeekly'[Top Of Yellow]
			            - 'SimulationPartForecasts_BufferItemsWeekly'[Top Of Red])-SimulationPartForecasts_BufferItemsWeekly[Projected EDU]*RELATED(Parts[RPlusLeadTime])
			    ),
			    Parts[InventoryMethod] = 1
			))/DISTINCTCOUNT('Calendar'[Date])
		formatString: #,0
		displayFolder: Simulations_Measures
		lineageTag: f32d0a43-36e5-44bd-9c84-936b8c9aff05

