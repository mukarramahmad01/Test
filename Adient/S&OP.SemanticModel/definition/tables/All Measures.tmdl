	measure DemandWithSellingPrice =
			VAR measure_=SELECTEDVALUE(Unit_SellingPrice[Unit])
			return SWITCH(measure_,
			"RMCost",IF(SELECTEDVALUE(Period[Period Commande])<>4,sumx(FILTER('SimulationPartForecastsDemandMonthly',SimulationPartForecastsDemandMonthly[Unit]="Cost"),'SimulationPartForecastsDemandMonthly'[Demand]),sumx(FILTER('SimulationPartForecastsDemandWeekly',SimulationPartForecastsDemandWeekly[Unit]="Cost"),'SimulationPartForecastsDemandWeekly'[Demand])),
			"SellingPrice",IF(SELECTEDVALUE(Period[Period Commande])<>4,sumx(FILTER('SimulationPartForecastsDemandMonthly',SimulationPartForecastsDemandMonthly[Unit]="Selling Price"),'SimulationPartForecastsDemandMonthly'[Demand]),sumx(FILTER('SimulationPartForecastsDemandWeekly',SimulationPartForecastsDemandWeekly[Unit]="Selling Price"),'SimulationPartForecastsDemandWeekly'[Demand])))
