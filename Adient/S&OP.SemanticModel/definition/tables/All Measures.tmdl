	measure 'Independent Demand' =
			VAR SelectedUnit=SELECTEDVALUE('Unit Children'[Unit])
			RETURN
			
			        IF(
			            SelectedUnit = "Stock Days",
			            DIVIDE(
			                SUMX(DemandForecasts, DemandForecasts[OriginalValue] * DemandForecasts[RawMaterialCost]),
			                [EDU Child Value]
			            ),
			            CALCULATE(
			                SUMX(
			                    DemandForecasts,
			                    DIVIDE(
			                        DemandForecasts[OriginalValue],
			                        CALCULATE(SELECTEDVALUE('Unit Children'[Quantity]), RELATEDTABLE('Unit Children'))
			                    )
			                )
