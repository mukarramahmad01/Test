	measure 'Service Level' =
			
			VAR TablePerId =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Service Level',
			            'Service Level'[Id],
			            'Service Level'[SimulationId]
			        ),
			        "SL",
			            DIVIDE(
			                SUM('Service Level'[RisksServiceLevel]),
			                SUM('Service Level'[NumberOfDays])
			            )
			    )
			RETURN
			AVERAGEX(
			    TablePerId,
			    [SL]
			)
		formatString: 0%;-0%;0%
		displayFolder: History&Simulations_Measures
		lineageTag: 31b12757-21a2-44bb-bfe8-3cb504639126

