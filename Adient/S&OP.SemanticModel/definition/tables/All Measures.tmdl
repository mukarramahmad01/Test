	measure 'Backorders Supply' =
			VAR Supply =
			    CALCULATE (
			        SUMX (
			            FILTER (
			                Simulation_Scheduling_SupplyOrders_Source,
			                Simulation_Scheduling_SupplyOrders_Source[PromiseDate_] < TODAY ()
			            ),
			            Simulation_Scheduling_SupplyOrders_Source[Quantity]
			        ),
			        REMOVEFILTERS ( 'Calendar' )
			    )
			RETURN if(MIN('Calendar'[Date])<=TODAY(),Supply,BLANK())
		formatString: 0
		displayFolder: Simulations_Measures
		lineageTag: cdb2ebdb-40c5-4ef3-8e35-7b03ec1c4ceb

