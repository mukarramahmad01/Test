table Unit
	lineageTag: 03700690-471e-41ba-98d9-fbd58fc9e841

	measure SimulationSupplyVal =
			VAR measure_=SELECTEDVALUE(Unit[Unit])
			return SWITCH(measure_,
			"Constrained",[SimulationConstrainedSupplyVal],
			"Unconstrained",[SimulationUnconstrainedSupplyVal])
		formatString: #,0
		lineageTag: 3b1d67fb-00d5-482f-a663-ed3b251fa67e

