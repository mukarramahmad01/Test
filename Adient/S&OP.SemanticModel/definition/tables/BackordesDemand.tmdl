table BackordesDemand
	lineageTag: 62120fb0-744d-4c29-837f-7ea05862f429

	column PartId
		dataType: int64
		formatString: 0
		lineageTag: bd7bb4a3-851c-4bea-a3d0-9200f5913005
		summarizeBy: none
		sourceColumn: PartId

		annotation SummarizationSetBy = Automatic

	column BackorderQty
		dataType: double
		lineageTag: ad194042-91de-4488-9ce9-106cc5fdd40f
		summarizeBy: sum
		sourceColumn: BackorderQty

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BackordesDemand = m
		mode: import
		queryGroup: Supply
		source =
				let
				    Source = Sql.Database(Server, Database, [Query=" SELECT
				            PartId,
				            SUM(Quantity) AS BackorderQty
				        FROM DemandOrders
				        WHERE DueDate < CAST(GETDATE() AS DATE)
				        GROUP BY PartId;
				"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

