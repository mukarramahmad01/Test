table Simulations
	lineageTag: e2acf46e-259a-45e2-9d8c-6d68a8f7d63b

	measure Scenario_Measure = MAX(Simulations[Index])
		formatString: 0
		lineageTag: b881c01d-eeed-414b-a887-aad23d8e2774

	measure Scenario_Name = MAX(Simulations[ScenarioName])
		lineageTag: 2fce0e1c-8e22-4d28-8296-d87cd05303e4

	column Id
		dataType: double
		formatString: 0
		lineageTag: 4b16e76f-ec1b-463f-b842-1b3ebceb3d90
		summarizeBy: none
		sourceColumn: Id

		annotation SummarizationSetBy = Automatic

	column SchedulingSetId
