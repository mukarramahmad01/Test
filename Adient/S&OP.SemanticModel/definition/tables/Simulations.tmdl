		formatString: 0
		lineageTag: 208a0dba-4400-4bbe-ab52-8d281af605db
		summarizeBy: none
		sourceColumn: SchedulingSetId

		annotation SummarizationSetBy = Automatic

	column ScenarioId
		dataType: double
		formatString: 0
		lineageTag: 1fe4e898-d8f6-4d23-92c0-301a55bdf0e8
		summarizeBy: count
		sourceColumn: ScenarioId

		annotation SummarizationSetBy = Automatic

	column ScenarioName
