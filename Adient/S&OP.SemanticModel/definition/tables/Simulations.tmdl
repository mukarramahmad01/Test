		lineageTag: 5f0cdc6b-4a9c-456d-81c8-9f46c5e4ebb9
		summarizeBy: none
		sourceColumn: ScenarioName

		annotation SummarizationSetBy = Automatic

	column Index = ```
			
			IF(
			    Simulations[ScenarioName] = "History",
			    "Last Year",
			    FORMAT(Simulations[Index1], "0")
			)
			
			
			```
		lineageTag: 28bc38bf-906e-4db5-98b9-aa240088402e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AD_Key = 1
		formatString: 0
		lineageTag: c1610b9a-df64-4595-b275-c0063df89d8e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Scenarions = "Scenario: "&Simulations[ScenarioName]
		lineageTag: 0b747999-85c7-4e17-b636-70faa4842f69
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Index1 =
			
			RANKX(
			    ALL('Simulations'),
			    'Simulations'[ScenarioId],
			    ,
			    ASC,
			    DENSE
			)
		formatString: 0
		lineageTag: 053033ac-a9d0-4eb3-a582-ea8f44884cf3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

