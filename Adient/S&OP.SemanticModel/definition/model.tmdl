model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Server Parameters'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'S&OP report Part'

	annotation PBI_QueryGroupOrder = 1

queryGroup RLS

	annotation PBI_QueryGroupOrder = 9

queryGroup Sources

	annotation PBI_QueryGroupOrder = 3

queryGroup RCCP

	annotation PBI_QueryGroupOrder = 8

queryGroup Historical

	annotation PBI_QueryGroupOrder = 7

queryGroup 'S&OP report Part\BOM'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'S&OP report Part\Packagings'

	annotation PBI_QueryGroupOrder = 0

queryGroup Supply

	annotation PBI_QueryGroupOrder = 2

queryGroup AdjustmentFactors

	annotation PBI_QueryGroupOrder = 6

queryGroup 'S&OP report Part\SimulationPartForecasts'

	annotation PBI_QueryGroupOrder = 2

queryGroup Historical\HistoryDemand

	annotation PBI_QueryGroupOrder = 0

queryGroup Calendar

	annotation PBI_QueryGroupOrder = 5

queryGroup Scenarios

	annotation PBI_QueryGroupOrder = 4

queryGroup 'S&OP report Part\Risks'

	annotation PBI_QueryGroupOrder = 3

annotation PBI_QueryOrder = ["SchedulingOrders","SchedulingSets","Simulation_Scheduling_SupplyOrders_Source","BOM_Multilevel","Resources","PartsPakagings","Packaging Units","HistoricalDemandSource","ResourceCalendars","SchedulingResourceDailyLoading","Server","Database","Sources","PartsS&OP","Parts","UDF","FutureDays","RLS_Activated","Parent Parts","RLS_Sources","RLS_VendorIdentifier","RLS_PlannerCode","RLS_UserResource","RLS_UserResourceFilters","RLS_Administrator","RLS_Location","IsEmpty","RLS_PlannerCodeValue","RLS_VendorIdentifierValue","RLS_LocationValue","AD_Key","Unit","AdjustmentFactors","SimulationPartForecasts_BufferItemsWeekly","SimulationPartForecasts_BufferItemsMonthly","SimulationPartForecastsMonthlyAll","SimulationPartForecastsMonthly","HistoryProjectedInventoryMonth_","SimulationPartForecastsWeeklyAll","Inv Agregation","URL","Calendar","StartDateAndEndDateForCalendar","EndWeek","EndMonth","PartUnitOfMeasures","SupplyOrders","Simulations","Scenarios","SimulationPartForecastsWeekly","HistoryProjectedInventoryWeek_","SimulationPartForecastsConstrainedAll","SimulationPartForecastsConstrainedMonthly","SimulationPartForecastsConstrainedWeekly","Service Level","RisksCriticalMonthly","RisksCriticalWeekly","RisksRedMonthly","RisksRedWeekly","RisksYellowMonthly","RisksYellowWeekly","RisksCriticalConstrainedMonthly","RisksCriticalConstrainedWeekly","RisksRedConstrainedMonthly","RisksRedConstrainedWeekly","RisksYellowConstrainedMonthly","RisksYellowConstrainedWeekly","Unit_SellingPrice","DemandForecasts","HistoryDays","SimulationPartForecastsDemandMonthly","SimulationPartForecastsDemandWeekly","HistoryDemandMonth_","SimulationsH","HistoryDemandWeek_","DemandHistoryEdits","HistoryProjectedInventoryAll","Workload Type","BackordesDemand"]

