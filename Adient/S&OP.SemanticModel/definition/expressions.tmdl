expression IsEmpty = ```
		let  
		    IsEmpty = (Tabl,Tab2,Tab3,value,mail) =>     
		    if Table.IsEmpty(Table.SelectRows(Tabl, each ([FieldName] =value)and ([Email] =mail))) and Table.IsEmpty(Table.SelectRows(Tab2, each ([FieldName] =value)and ([Email] =mail))) and Table.IsEmpty(Table.SelectRows(Tab3, each ([FieldName] =value)and ([Email] =mail))) then 1 else 0
		in  
		    IsEmpty
