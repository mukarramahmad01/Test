expression SimulationPartForecastsMonthlyAll = ```
		let
		    Source = Sql.Database(Server, Database, [Query="SELECT 
		    t1.Id,
		    EOMONTH(t1.Date) AS Date,
		    SUM(t1.ProjectedDailyDemand) AS ProjectedDailyDemand,
		COUNT(Date) as NumberOfDays,
		    -- ✅ Somme des valeurs positives de ProjectedInventory
		    SUM(CASE WHEN t1.ProjectedInventory > 0 THEN t1.ProjectedInventory ELSE 0 END) 
		        AS ProjectedInventory_Positive,
		
		    -- ✅ Somme des valeurs négatives de ProjectedInventory
		    SUM(CASE WHEN t1.ProjectedInventory < 0 THEN t1.ProjectedInventory ELSE 0 END) 
		        AS ProjectedInventory_Negative,
		    MAX(CASE WHEN t1.Date = EOMONTH(t1.Date) THEN t1.ProjectedInventory END) AS EndMonthInventory,
		    SUM(t1.ProjectedEDU) AS ProjectedEDU,
		
		    -- ✅ Risques
		    SUM(CASE WHEN (t1.ProjectedInventory >= 0) THEN 1 ELSE 0 END) AS RisksServiceLevel,
		    SUM(CASE WHEN (t1.ProjectedInventory <= 0 And t1.TopOfYellow>0) THEN 1 ELSE 0 END) AS RisksCritical,
		    SUM(CASE WHEN t1.ProjectedInventory > 0 AND t1.ProjectedInventory <= t1.TopOfRed / 2 THEN 1 ELSE 0 END) AS RisksRed,
		    SUM(CASE WHEN t1.ProjectedInventory > t1.TopOfRed / 2 AND t1.ProjectedInventory <= t1.TopOfRed THEN 1 ELSE 0 END) AS RisksYellow,
		    t1.SimulationId
		
		FROM report.SimulationPartForecasts t1
		WHERE CAST(t1.Date AS date) >= CAST(GETDATE() AS date)
		  AND t1.Date <= '" & Date.ToText(Date.AddDays(Date.From(DateTime.LocalNow()), FutureDays), "yyyy-MM-dd") & "'
		GROUP BY 
		    t1.Id,
		    EOMONTH(t1.Date),
		    t1.SimulationId;
		
		"]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{"Date", type date})
		in
		    #"Changed Type"
		```
	lineageTag: d23c8832-4a9a-413f-910f-878287d7f65a
	queryGroup: 'S&OP report Part\SimulationPartForecasts'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression SimulationPartForecastsWeeklyAll = ```
		let
		    Source = Sql.Database(Server, Database, [Query="SELECT
		    Id,Date as Date1,ProjectedDailyDemand,ProjectedInventory,
		
		    -- ✅ Somme des valeurs positives de ProjectedInventory
		    CASE WHEN t1.ProjectedInventory > 0 THEN t1.ProjectedInventory ELSE 0 END 
		        AS ProjectedInventory_Positive,
		
		    -- ✅ Somme des valeurs négatives de ProjectedInventory
		    CASE WHEN t1.ProjectedInventory < 0 THEN t1.ProjectedInventory ELSE 0 END 
		        AS ProjectedInventory_Negative,
		
		 ProjectedEDU,
		    -- ✅ Risks
		CASE 
		            WHEN ProjectedInventory <= 0 
		             AND TopOfYellow > 0 
		            THEN 1 ELSE 0 
		        END AS RisksCritical,
		CASE 
		            WHEN ProjectedInventory > 0 
		             AND ProjectedInventory <= TopOfRed / 2 
		            THEN 1 ELSE 0 
		        END AS RisksRed,
		
		    CASE 
		            WHEN ProjectedInventory > TopOfRed / 2 
		             AND ProjectedInventory <= TopOfRed 
		            THEN 1 ELSE 0 
		        END AS RisksYellow,
		    SimulationId
		
		FROM report.SimulationPartForecasts t1
		    WHERE CAST(t1.Date AS date) >= CAST(GETDATE() AS date)
		      AND t1.Date <= '" & Date.ToText(
		            Date.AddDays(Date.From(DateTime.LocalNow()), FutureDays),
		            "yyyy-MM-dd"
		        ) & "';
		"]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{"Date1", type date}),
		    #"Added Custom" = Table.AddColumn(#"Changed Type", "Date", each Date.EndOfWeek([Date1], Day.Monday),type date),
		    #"Added Custom2" = Table.AddColumn(#"Added Custom", "EndWeekInventory", each if [Date1]=[Date] then [ProjectedInventory] else 0,type number),
		    #"Grouped Rows" = Table.Group(#"Added Custom2", {"Date", "Id", "SimulationId"}, {{"ProjectedDailyDemand", each List.Sum([ProjectedDailyDemand]), type nullable number}, {"ProjectedInventory_Positive", each List.Sum([ProjectedInventory_Positive]), type nullable number}, {"ProjectedInventory_Negative", each List.Sum([ProjectedInventory_Negative]), type nullable number}, {"ProjectedEDU", each List.Sum([ProjectedEDU]), type nullable number}, {"RisksCritical", each List.Sum([RisksCritical]), type number}, {"RisksRed", each List.Sum([RisksRed]), type number}, {"RisksYellow", each List.Sum([RisksYellow]), type number}, {"EndWeekInventory", each List.Sum([EndWeekInventory]), type number}})
		in
		    #"Grouped Rows"
		```
	lineageTag: e591890c-a3f5-47d6-8c15-33c58bf7d6f5
	queryGroup: 'S&OP report Part\SimulationPartForecasts'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression SimulationPartForecastsConstrainedAll = ```
		let
		    Source = Sql.Database(Server, Database, [Query="
		    WITH
		    SchedulingSetsRCCP AS (
		        SELECT Id
		        FROM dbo.SchedulingSets
		        WHERE Type = 1
		    ),
		    SchedulingOrders1 AS (
		        SELECT t1.OrderNumber, t1.PartId, t1.PromiseDate
		        FROM report.SchedulingOrders t1
		        INNER JOIN SchedulingSetsRCCP t2
		            ON t1.SchedulingSetId = t2.Id
		    ),
		SupplyByDay AS (SELECT
		            SimulationPartId AS Id,
		            OrderNumber,SimulationId,
		            CAST(
		                CASE
		                    WHEN OrderReceiptDate IS NULL THEN RequestDate
		                    ELSE OrderReceiptDate
		                END AS DATE
		            ) AS [Date],
		            SUM(Quantity) AS SupplyQty
		        FROM SimulationSupplyOrders
		        WHERE
		            CASE
		                WHEN OrderReceiptDate IS NULL THEN cast(RequestDate as date)
		                ELSE cast(OrderReceiptDate as date)
		            END > Cast(GETDATE() as date)
		    GROUP BY SimulationPartId,SimulationId, CASE
		                    WHEN OrderReceiptDate IS NULL THEN RequestDate
		                    ELSE OrderReceiptDate
		                END, OrderNumber
		),
		SupplyConstrained AS (
		    SELECT
		        t1.Id,t1.SimulationId,
		        CAST(
		            ISNULL(t2.PromiseDate, t1.[Date]) AS DATE
		        ) AS [Date],
		        SUM(t1.SupplyQty) AS SupplyQty,
		    SUM(CASE 
		        WHEN CAST(t2.PromiseDate AS DATE) = CAST(t1.[Date] AS DATE) THEN 1 
		        ELSE 0 
		    END ) AS status
		    FROM SupplyByDay t1
		    left JOIN SchedulingOrders1 t2
		        ON t1.OrderNumber = t2.OrderNumber
		        AND t1.Id = t2.PartId
		    GROUP BY t1.Id,t1.SimulationId, CAST(ISNULL(t2.PromiseDate, t1.[Date]) AS DATE)
		),
		PartsConstrained as (select distinct t1.Id from SupplyConstrained t1 where status=0),
		Base AS (
		    SELECT
		        p.Id,p.SimulationId,
		        p.[Date],p.TopOfRed,p.TopOfYellow,
		        ISNULL(sc.SupplyQty, 0) AS SupplyQtyConstrained,
		        case when cast(p.Date as date)=cast(getdate() as date) then 0 else ISNULL(p.ProjectedDailyDemand, 0) end AS DemandQty,
		        P.ProjectedInventory AS InitialInventory
		    FROM Report.SimulationPartForecasts p
		    Inner JOIN PartsConstrained Pcs on p.Id=Pcs.Id
		    LEFT JOIN SupplyConstrained sc ON sc.Id = p.Id AND sc.[Date] = p.[Date] and sc.SimulationId=p.SimulationId
		where cast(p.date as date)>=cast(getdate() as date) and p.date<='" & Date.ToText(Date.AddDays(Date.From(DateTime.LocalNow()),FutureDays),"yyyy-MM-dd") & "'
		),
		
		Final AS (
		    SELECT
		        b.Id,b.SimulationId,
		        b.[Date],b.TopOfRed,b.TopOfYellow,
		        b.SupplyQtyConstrained,
		        b.DemandQty,
		        b.InitialInventory
		    FROM Base b
		)SELECT 
		    Id,SimulationId,ISNULL(TopOfRed, 0) as TopOfRed,ISNULL(TopOfYellow, 0) as TopOfYellow,
		    [Date],
		SUM(SupplyQtyConstrained - DemandQty)
		    OVER (PARTITION BY Id,SimulationId ORDER BY [Date] ROWS UNBOUNDED PRECEDING)
		+ FIRST_VALUE(InitialInventory) OVER (PARTITION BY Id,SimulationId ORDER BY [Date]) AS ProjectedInventoryConstrained
		FROM Final;
		"]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Date", type date}, {"ProjectedInventoryConstrained", Int64.Type}}),
		    #"Added Custom3" = Table.AddColumn(#"Changed Type", "RisksCritical", each if [ProjectedInventoryConstrained]<=0 and [TopOfYellow]>0 then 1 else 0,type number),
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "RisksRed", each if [ProjectedInventoryConstrained]>0 and[ProjectedInventoryConstrained]<=([TopOfRed]/2) then 1 else 0,type number),
		    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "RisksYellow", each if [ProjectedInventoryConstrained]>([TopOfRed]/2) and[ProjectedInventoryConstrained]<=[TopOfRed] then 1 else 0,type number),
		    #"Added Custom1" = Table.AddColumn(#"Added Custom5", "ProjectedInventoryConstrainedNegative", each if [ProjectedInventoryConstrained]<0 then [ProjectedInventoryConstrained] else 0,type number),
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1",  "ProjectedInventoryConstrainedPositive", each if [ProjectedInventoryConstrained]>0 then [ProjectedInventoryConstrained] else 0,type number)
		in
		    #"Added Custom2"
		```
	lineageTag: 59088627-7d11-4681-abf5-011ff279405f
	queryGroup: 'S&OP report Part\SimulationPartForecasts'

