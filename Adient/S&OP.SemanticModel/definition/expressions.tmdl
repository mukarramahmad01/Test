expression StartDateAndEndDateForCalendar =
		let
		    DateDebut = DateTime.Date(Date.AddDays(DateTime.LocalNow(), -1)),
		    DateFin = Date.AddDays(Date.From(DateTime.LocalNow()), FutureDays),
		    NbJours = Duration.Days(DateFin - DateDebut),
		    ListeDates = if NbJours>=0 then List.Dates(DateDebut, NbJours+1, #duration(1,0,0,0)) else List.Dates(DateTime.Date(DateTime.LocalNow()), -NbJours+1, #duration(1,0,0,0)),
		    TableDates = Table.FromColumns({ListeDates}, {"Date"}),
		    #"Type modifié" = Table.TransformColumnTypes(TableDates,{{"Date", type date}})
		in
		    #"Type modifié"
