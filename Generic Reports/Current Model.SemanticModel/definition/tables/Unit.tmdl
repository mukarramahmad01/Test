	partition Unit = m
		mode: import
		source = ```
				let
				   
				    
				     Source = Sql.Database(#"Server", #"Database", [Query="(SELECT PartId, Quantity, Unit, Dimension FROM report.PartPackagings) union (select Id as PartId, 1 as Quantity, 'Quantity' as Unit, 'NonStandard' as Dimension from report.parts) union (select Id as PartId, IIF(RawMaterialsCost>0,1/RawMaterialsCost,99999999999) as Quantity, 'Cost' as Unit, 'NonStandard' as Dimension from report.parts) union (select Id as PartId, 1 as Quantity, 'Stock Days' as Unit, 'NonStandard' as Dimension From report.Parts)", CommandTimeout=#duration(0, 1, 30, 0)])
				in
				    Source
				```

	annotation PBI_ResultType = Table

