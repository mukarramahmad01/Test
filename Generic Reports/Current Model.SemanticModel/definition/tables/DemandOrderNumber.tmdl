	partition DemandOrderNumber = calculated
		mode: import
		source =
				SELECTCOLUMNS(FILTER (
				        DemandOrders,
				        [OrderType] IN {"Sales Order", "SO"}
				    ),"PartId",[PartId],"PartNumber",[PartNumber],"Location",[Location],"OrderNumber",[OrderNumber],"Customer",[Customer])

	annotation PBI_Id = 54ea9457a6944ab680ef52f2ecefeeff

