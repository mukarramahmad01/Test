	column OnHandInventory-PartInventories = PartInventories[OnHandInventory]-PartInventories[Cumulative Demand]
		lineageTag: 9529d22d-a6d1-4478-b315-4a1913d3343c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

