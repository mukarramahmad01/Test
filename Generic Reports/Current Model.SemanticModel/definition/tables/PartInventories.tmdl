	column Expiration<Today = ```
			IF(PartInventories[ExpirationDate]<TODAY(),1,0) 
			```
		formatString: 0
		lineageTag: f10cf567-3ed8-4f36-b204-24beff90e893
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Index =
			
			RANKX(
			    FILTER(
			        'PartInventories',
			        'PartInventories'[PartId] = EARLIER('PartInventories'[PartId])
			    ),
			    'PartInventories'[BatchId],
			    ,
			    ASC,
			    DENSE
			)
		formatString: 0
		lineageTag: ae6967f5-7bd8-483d-af18-31eaf7d63909
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ExpirationDate_ID = [ExpirationDate]+[Index]
		formatString: General Date
		lineageTag: 4b692111-6288-485f-899b-6c6dcebeb0e5
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 9cf8e544-bb3f-4907-84ee-d33a7a7a3a77
			defaultHierarchy: LocalDateTable_4ad624b7-f005-48c7-b8ca-7ff6b60eae21.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Cumulative Demand' = ```
			
			VAR CurrentQuantity = 'PartInventories'[Quantity]
			VAR PreviousDate = 'PartInventories'[PreviousDate]
			VAR CurrentPartID = 'PartInventories'[PartId]
			VAR PreviousQuantities = 
			    CALCULATE(
			        SUM('PartInventories'[Quantity]),
			        FILTER(
			            'PartInventories',
			            'PartInventories'[PartId] = CurrentPartID && 'PartInventories'[ExpirationDate_ID] = PreviousDate)
			        )
			RETURN
			    CurrentQuantity-PreviousQuantities
			```
		lineageTag: 592ea93a-0fcd-4eba-92a2-974151a364f1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CumulativeColumn =
			
			VAR CurrentIndex = 'PartInventories'[ExpirationDate_ID]
			VAR CurrentPartID = 'PartInventories'[PartId]
			VAR CumulativeNegatives =
			    SUMX(
			        FILTER(
			            'PartInventories',
			            'PartInventories'[ExpirationDate_ID] <= CurrentIndex &&
			            'PartInventories'[PartId] = CurrentPartID
			        ),
			        'PartInventories'[OnHandInventory-PartInventories]
			    )
			RETURN
			  IF(CumulativeNegatives<'PartInventories'[OnHandInventory-PartInventories],CumulativeNegatives,'PartInventories'[OnHandInventory-PartInventories])
		lineageTag: f09466f5-7712-4ab5-83ec-7eea5ca7da7a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column PreviousDate = ```
			
			VAR CurrentDate = 'PartInventories'[ExpirationDate_ID]
			VAR CurrentPartID = 'PartInventories'[PartId]
			
			VAR PreviousQuantityValue = 
			    CALCULATE(
			        MAX('PartInventories'[ExpirationDate_ID]),
			        FILTER(
			            'PartInventories',
			            'PartInventories'[PartId] = CurrentPartID &&
			            'PartInventories'[ExpirationDate_ID] < CurrentDate
			        )
			    )
			
			RETURN
			    PreviousQuantityValue
			```
		formatString: General Date
		lineageTag: c4e0b0d9-9133-44f8-a6f0-07de46d0c315
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 84dfc2bc-90cb-4bc3-8e5a-abacc14f202e
			defaultHierarchy: LocalDateTable_5fca108e-c6f6-4f4a-9727-c6ef5f4140be.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition PartInventories = m
		mode: import
		queryGroup: Source
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT t1.PartId, t1.Date, t1.IssuedInventory, t1.OnHandInventory, t1.BatchId, t1.ExpirationDate, t1.Id, t2.Quantity as Qty, t2.DueDate  FROM PartInventories t1 With (NOLOCK) left join (select Quantity,DueDate,PartId from Report.DemandOrders With (NOLOCK)) t2 on t1.PartId=t2.PartId where t1.ExpirationDate is not null "]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"ExpirationDate", type date}, {"DueDate", type date}, {"Date", type date}}),
				    #"Personnalisée ajoutée" = Table.AddColumn(#"Changed Type", "Check", each [ExpirationDate]>[DueDate], type logical),
				    #"Added Custom" = Table.AddColumn(#"Personnalisée ajoutée", "Quantity", each if [Check]=false then null else [Qty],type number),
				    #"Lignes groupées" = Table.Group(#"Added Custom", {"PartId", "Date", "OnHandInventory", "BatchId", "ExpirationDate"}, {{"Quantity", each List.Sum([Quantity]), type number}})
				in
				    #"Lignes groupées"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

